{
  "name": "@mattt/paseo-preferred-microphone",
  "version": "0.1.0",
  "private": true,
  "description": "A Paseo plugin that makes dictation use a microphone you choose instead of the system default.",
  "keywords": [
    "dictation",
    "microphone",
    "paseo",
    "paseo-plugin"
  ],
  "license": "MIT",
  "author": "Mattt (https://mat.tt)",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "README.md",
    "LICENSE.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check && npm run typecheck && vp test"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.14.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.88.1",
    "typescript": "^5.9.3",
    "vite-plus": "^1.4.0",
    "zod": "^4.4.3"
  }
}
